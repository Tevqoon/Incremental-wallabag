# Copy to .env and fill in. .env is gitignored.
#
# Create the client at:
#   https://app.wallabag.it -> Settings -> API clients management -> Create a new client
# The client id looks like "12_3o53gl30vhgk0c8ks4cocww08o84448osgo40wgw4gwkoo8skc".

WALLABAG_CLIENT_ID=
WALLABAG_CLIENT_SECRET=
WALLABAG_USERNAME=
WALLABAG_PASSWORD=

# Only needed for the "increader import-substack" subcommand — see the
# commented-out ingest.substack block in config.yaml. This is the
# substack.sid cookie from a browser signed into an account with an active
# paid subscription to the publication being backfilled.
#
# To find it in Safari: Settings -> Advanced -> "Show features for web
# developers", then with a Substack page open, Develop -> Show Web
# Inspector -> Storage -> Cookies. It legitimately starts with "s%3A" —
# that prefix is part of the cookie itself, paste it in whole.
SUBSTACK_SID=
